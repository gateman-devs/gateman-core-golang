      },
      "example": {
        "request": {
          "image": "https://res.cloudinary.com/themizehq/image/upload/v1705754919/b3660e9e-4bed-4063-8400-88f5e109aacb.jpg",
          "verbose": true,
          "threshold": 0.7
        },
        "response": {
          "body": {
